# frozen_string_literal: true

desc "Run the specs co-located in each lib file's __END__ section"
task :test do
  sh "bundle exec scampi"
end

desc "Check the linter's own Ruby against the house cops"
task :rubocop do
  sh "bundle exec rubocop"
end

desc "Regenerate lib/remlint/tables.rb from a Remind checkout"
task :tables, [:remind_root] do |_task, args|
  sh "ruby tasks/generate_tables.rb #{args.fetch(:remind_root, '..')}"
end

desc "Lint the Remind files shipped with Remind itself"
task :smoke, [:remind_root] do |_task, args|
  root = args.fetch(:remind_root, "..")
  sh "ruby -Ilib exe/remlint #{root}/examples #{root}/tests #{root}/include" do |ok, _status|
    # A corpus is expected to have offences; the point is that we survive it.
    puts ok ? "smoke: clean" : "smoke: offences reported (expected)"
  end
end

task default: %i[test rubocop]
