#!/usr/bin/env bash
#
# Every suite in the repository. Three gems share this lib/ -- the bindings,
# the converter and the linter -- so there is one run, not three.
#
# The bindings' specs open the shared library, so it is compiled first.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Compiling needs a C toolchain, which lives in the flake devshell; the suites
# only need the library that comes out of it. So compile when the library is
# missing or older than the sources, and otherwise leave it alone -- that is
# what lets `bin/test` run outside the devshell as well as inside it.
library="lib/remind/libremind.$(ruby -rrbconfig -e 'print RbConfig::CONFIG["DLEXT"]')"

if [ -f "$library" ] && [ -z "$(find remind-v*/src ext/remind -newer "$library" \( -name '*.c' -o -name '*.h' \) 2>/dev/null)" ]; then
  echo "==> compile (up to date)"
else
  echo "==> compile"
  rake compile
fi

echo "==> specs"
# -Ilib: the converter's specs say `require "remind"`, because to them the
# bindings are a gem like any other -- they just happen to share this tree.
RUBYOPT="-Ilib" scampi $(grep -rl '^__END__' lib --include='*.rb' | sort)
