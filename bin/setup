#!/usr/bin/env bash
#
# Everything a fresh checkout needs before `bin/test` will run.
set -euo pipefail
IFS=$'\n\t'

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "1/3 Installing bundles"
bundle install
(cd rem2ics && bundle install)

echo "2/3 Compiling Remind into lib/remind/"
# ./configure and one -fPIC -shared compile of the vendored sources. Needs a C
# compiler and make; inside `nix develop` both are already there. This is the
# same compile CI runs before packaging a precompiled gem.
rake compile

echo "3/3 Installing git hooks"
lefthook install
