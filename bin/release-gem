#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"

require_relative "../lib/remind/version"
require_relative "../lib/rem2ics/version"
require_relative "../lib/remlint/version"

# Releases the three gems in this repository:
#
#   remind-rb   the bindings. Published as a source gem AND as one precompiled
#               gem per platform, built in CI by cross-compile.yml with the
#               shared library already inside, so installing compiles nothing.
#   rem2ics     the converter. Pure Ruby, built here.
#   remlint     the linter. Pure Ruby, built here, and dependent on neither.
#
# Push order matters: rem2ics depends on remind-rb, so the bindings go first.
# Each carries its own version -- one tracks Remind, the other does not -- so
# each is checked, built and tagged on its own. Naming one on the command line
# releases only that one.
#
# Pass --dry-run to build and verify without pushing.

# `delete` answers the argument when it was there, and nil when it was not.
DRY_RUN = !ARGV.delete("--dry-run").nil?

WORKFLOW = "cross-compile.yml"
PKG_DIR = "pkg"

GEMS = [
  {
    name:        "remind-rb",
    version:     Remind::VERSION,
    gemspec:     "remind-rb.gemspec",
    precompiled: true,
  },
  {
    name:        "rem2ics",
    version:     Rem2ics::VERSION,
    gemspec:     "rem2ics.gemspec",
    precompiled: false,
  },
  {
    name:        "remlint",
    version:     RemLint::VERSION,
    gemspec:     "remlint.gemspec",
    precompiled: false,
  },
].freeze

ROOT = File.expand_path("..", __dir__)
Dir.chdir(ROOT)

wanted = ARGV.first
releasing = GEMS.select { |gem| wanted.nil? || gem[:name] == wanted }

if releasing.empty?
  abort "Usage: bin/release-gem [#{GEMS.map { |gem| gem[:name] }.join("|")}] [--dry-run]"
end

banner = releasing.map { |gem| "#{gem[:name]} #{gem[:version]}" }.join(", ")

if DRY_RUN
  puts "Releasing #{banner} (dry run)"
else
  puts "Releasing #{banner}"
end

puts

# Nothing here compiles, and nothing here runs a suite. The platform gems are
# built on GitHub by cross-compile.yml and downloaded below; the suites run
# there too, in test.yaml. A release is a download and ten pushes.

# --- 1. Each gem must be ahead of what is already published. ------------------
releasing.each do |gem|
  remote = `gem specification #{gem[:name]} version --remote 2>&1`

  if $?.success?
    published = remote[/version: (.+)/, 1]&.strip
    puts "#{gem[:name]}: local #{gem[:version]}, remote #{published}"

    if Gem::Version.new(gem[:version]) <= Gem::Version.new(published)
      abort "ERROR: #{gem[:name]} #{gem[:version]} is not ahead of published #{published}"
    end
  else
    puts "#{gem[:name]}: not yet published, first release"
  end
end
puts

# --- 2. Build the pure-Ruby gems, and download the compiled ones. -------------
# A bad build then aborts the whole release rather than leaving half of it on
# RubyGems with a dependency pointing at a version that never arrived.
FileUtils.rm_rf(PKG_DIR)
FileUtils.mkdir_p(PKG_DIR)

def build(gem)
  puts "Building #{gem[:gemspec]}..."
  package = File.join(ROOT, PKG_DIR, "#{gem[:name]}-#{gem[:version]}.gem")

  system(
    "gem",
    "build",
    gem[:gemspec],
    "--output",
    package,
    chdir: ROOT,
  ) ||
    abort("ERROR: gem build failed for #{gem[:name]}")

  package
end

# The precompiled gems are not built here -- they are built on the platforms
# they are for, by CI, because ./configure probes the machine it runs on.
def download_precompiled(gem)
  unless system("gh --version > /dev/null 2>&1")
    abort "ERROR: the GitHub CLI (gh) is required to fetch precompiled gems: https://cli.github.com"
  end

  puts "Locating latest successful #{WORKFLOW} run..."
  run_id = `gh run list --workflow=#{WORKFLOW} --status success --limit 1 --json databaseId --jq '.[0].databaseId'`.strip

  if run_id.empty?
    abort "ERROR: no successful #{WORKFLOW} run found. Push to main and let CI build the platform gems first."
  end

  puts "Downloading precompiled gems from run #{run_id}..."
  system(
    "gh",
    "run",
    "download",
    run_id,
    "--dir",
    PKG_DIR,
    "--pattern",
    "cross-gem-*",
  ) ||
    abort("ERROR: failed to download artifacts from run #{run_id}")

  found = Dir["#{PKG_DIR}/**/#{gem[:name]}-#{gem[:version]}-*.gem"].sort

  if found.empty?
    built = Dir["#{PKG_DIR}/**/*.gem"].map { |path| File.basename(path) }

    if built.empty?
      abort "ERROR: run #{run_id} produced no gems."
    end
    abort "ERROR: the latest CI run built #{built.join(", ")}, not version #{gem[:version]}.\n" \
          "Push #{gem[:version]} to main, wait for #{WORKFLOW} to finish, then re-run."
  end

  puts "Precompiled platform gems for #{gem[:version]}:"
  found.each { |path| puts "  #{File.basename(path)}" }

  found
end

packages = releasing.to_h do |gem|
  built = [build(gem)]
  if gem[:precompiled]
    built += download_precompiled(gem)
  end

  [gem[:name], built]
end
puts

# --- 3. Push in dependency order, tolerating what is already there. -----------
# A release that dies partway through can simply be re-run.
def push(package)
  puts "Pushing #{File.basename(package)}..."
  out, status = Open3.capture2e("gem", "push", package)
  print out

  # Already published is not a failure: it is what a re-run of a release that
  # died partway through looks like.
  if status.success?
    nil
  elsif out.include?("has already been pushed")
    puts "  (already published -- skipping)"
  else
    abort "ERROR: gem push failed for #{package}"
  end
end

releasing.each do |gem|
  packages.fetch(gem[:name]).each do |package|
    if DRY_RUN
      puts "[dry run] would push #{File.basename(package)}"
    else
      push(package)
    end
  end
end

puts
if DRY_RUN
  puts "Dry run complete -- #{packages.values.flatten.length} package(s) build cleanly"
  releasing.each { |gem| puts "[dry run] would tag #{gem[:name]}-v#{gem[:version]}" }
else
  # Tag only once the gems are actually published, so a tag never points at an
  # unreleased version.
  releasing.each do |gem|
    puts "Released #{gem[:name]} #{gem[:version]} (#{packages.fetch(gem[:name]).length} package(s))"

    system(File.join(__dir__, "tag-version"), gem[:name]) ||
      abort("ERROR: release succeeded but tagging #{gem[:name]} failed")
  end
end
