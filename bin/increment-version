#!/usr/bin/env ruby
# frozen_string_literal: true

require "erb"
require_relative "../lib/remind/version"
require_relative "../lib/rem2ics/version"
require_relative "../lib/remlint/version"

USAGE = <<~TEXT
  Usage:
    bin/increment-version                     bump remind-rb's segment (the 4th)
    bin/increment-version <remind-version>    track a newly vendored Remind, e.g. 06.03.00
    bin/increment-version <gem> <segment>     bump rem2ics or remlint: major, minor or patch

  remind-rb's version is <Remind release>.<our release>. The first three
  segments are not ours to choose -- they say which Remind this gem vendors and
  binds -- so bumping them means moving to a new release, which resets our
  segment to 0 and requires the sources to be vendored already.

  rem2ics and remlint have versions of their own: one is a converter and the
  other a linter, and neither is a packaging of Remind.
TEXT

# Where each of the other two gems keeps its version constant.
OTHERS = {
  "rem2ics" => "lib/rem2ics/version.rb",
  "remlint" => "lib/remlint/version.rb",
}.freeze

ROOT = File.expand_path("..", __dir__)

# Each of these lockfiles pins a path gem -- its own, and in the converter's
# case remind-rb next door -- at a concrete version. They do not follow a bump
# on their own, so they are regenerated here or they drift.
#
# The repository's own Gemfile is not in this list: it names its gems outright
# for nix's sake and holds no path gem, so a version bump cannot change it.
GEMFILES = [
  File.join(ROOT, "rem2ics", "Gemfile"),
  File.join(ROOT, "linter", "Gemfile"),
].freeze

def relock
  GEMFILES.each do |gemfile|
    relative = gemfile.sub("#{ROOT}/", "")
    puts "Relocking #{relative}..."

    ok = system(
      { "BUNDLE_GEMFILE" => gemfile, "BUNDLE_FROZEN" => "false" },
      "bundle",
      "install",
      chdir: File.dirname(gemfile),
      out:   File::NULL,
    )

    unless ok
      abort "ERROR: bundle install failed for #{relative}"
    end
  end
end

def bump_remind_rb(version, remind_version)
  template = File.join(
    ROOT,
    "lib",
    "remind",
    "version.rb.erb",
  )
  output = File.join(
    ROOT,
    "lib",
    "remind",
    "version.rb",
  )

  File.write(output, ERB.new(File.read(template)).result(binding))
end

def bump_other(name, segment)
  path = File.join(ROOT, OTHERS.fetch(name))
  source = File.read(path)
  current = source[/VERSION = "(\d+\.\d+\.\d+)"/, 1] or abort "ERROR: no VERSION in #{path}"
  major, minor, patch = current.split(".").map(&:to_i)

  case segment
  when "major" then [major + 1, 0, 0]
  when "minor" then [major, minor + 1, 0]
  when "patch" then [major, minor, patch + 1]
  else abort USAGE
  end => [major, minor, patch]

  version = [major, minor, patch].join(".")
  File.write(path, source.sub(/VERSION = "#{current}"/, %(VERSION = "#{version}")))

  [current, version]
end

case ARGV[0]
when nil
  current = Remind::VERSION
  version = "#{current.split(".")[0, 3].join(".")}.#{current.split(".").last.to_i + 1}"

  bump_remind_rb(version, Remind::REMIND_VERSION)
  relock
  puts "remind-rb: #{current} -> #{version}"

when /\A\d+\.\d+\.\d+\z/
  current = Remind::VERSION
  remind_version = ARGV[0]
  version = "#{remind_version.split(".").map { |part| Integer(part, 10) }.join(".")}.0"

  # Keep the claim honest: the version says which Remind is inside, so moving
  # it has to move the sources too, or the version lies.
  vendored = File.join(ROOT, "remind-v#{remind_version}")
  unless File.directory?(File.join(vendored, "src"))
    abort "ERROR: Remind #{remind_version} is not vendored: no #{vendored}/src"
  end

  puts "Vendored sources: #{File.basename(vendored)}"
  bump_remind_rb(version, remind_version)
  relock
  puts "remind-rb: #{current} -> #{version}"

when *OTHERS.keys
  name = ARGV[0]
  current, version = bump_other(name, ARGV[1])
  relock
  puts "#{name}: #{current} -> #{version}"

else
  warn USAGE
  exit 1
end
