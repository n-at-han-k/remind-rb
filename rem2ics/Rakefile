# frozen_string_literal: true

desc "Run the specs co-located in each lib file's __END__ section"
task :test do
  sh "bundle exec scampi $(grep -rl '^__END__' lib --include='*.rb' | sort)"
end

desc "Check the converter's Ruby against the house cops"
task :rubocop do
  # The cops and their configuration live one directory up, with the bindings
  # this gem is built on: one house style, defined once.
  sh "bundle exec rubocop --config ../.rubocop.yml lib exe"
end

desc "Convert the reminder files that ship with Remind"
task :smoke do
  sh "ruby -Ilib -I../lib exe/rem2ics ../remind-v06.02.10/tests/*.rem > /dev/null" do |ok, _status|
    puts ok ? "smoke: converted" : "smoke: failed"
  end
end

task default: %i[test rubocop]
